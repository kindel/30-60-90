{
  "kind": "kindel.30-60-90.template",
  "version": 1,
  "id": "product-senior",
  "label": "Senior product leader",
  "seatTitle": "VP of Product",
  "level": "senior",
  "function": "product",
  "include180": false,
  "columns": {
    "objective": "Objective",
    "criteria": "Criteria",
    "tactics": "Tactics",
    "status": "Status"
  },
  "hints": {
    "objective": "Objective",
    "criteria": "I can …",
    "tactics": "Tactic",
    "status": "Status"
  },
  "horizons": [
    {
      "id": "d30",
      "offsetDays": 30,
      "name": "Land",
      "help": "Learn the system. Frequent feedback."
    },
    {
      "id": "d60",
      "offsetDays": 60,
      "name": "Understand Direction; Sense Big Problems",
      "help": "Contribute to real work with guardrails."
    },
    {
      "id": "d90",
      "offsetDays": 90,
      "name": "Start Formulating Plan",
      "help": "Own something real enough to show how you operate."
    },
    {
      "id": "d180",
      "offsetDays": 180,
      "name": "Ship has Turned",
      "optional": true,
      "help": "You are running the seat. The plan is how you operate, not how you land."
    }
  ],
  "help": {
    "criteria": "First person, checkable: I can…, I know…, I have…",
    "tactics": "What you'll do to get there: meetings, reading, deliverables.",
    "badCriterion": "Meet with the PMs"
  },
  "lenses": [
    {
      "id": "customer",
      "name": "Customer",
      "help": "Who we serve and why they buy.",
      "suggestedFacets": [
        "Dealers/users of the product",
        "3rd parties",
        "Programs"
      ],
      "facets": [
        {
          "id": "end-users",
          "name": "End users",
          "cells": {
            "d30": {
              "example": {
                "objective": "Know who buys",
                "criteria": [
                  "I can name our top 10 customers."
                ],
                "tactics": [
                  "Ride 5 support calls",
                  "Read top reviews"
                ]
              }
            },
            "d60": {
              "example": {
                "objective": "Find their pain",
                "criteria": [
                  "I can list their top 3 complaints."
                ],
                "tactics": [
                  "Visit 3 customers",
                  "Mine tickets"
                ]
              }
            },
            "d90": {
              "example": {
                "objective": "Set direction",
                "criteria": [
                  "My plan cites customer input."
                ],
                "tactics": [
                  "Draft customer memo"
                ]
              }
            }
          }
        },
        {
          "id": "partners",
          "name": "Partners",
          "cells": {
            "d30": {
              "example": {
                "objective": "Meet partners",
                "criteria": [
                  "I can name our top 5 partners."
                ],
                "tactics": [
                  "Meet top 5 partners"
                ]
              }
            },
            "d60": {
              "example": {
                "objective": "Hear issues",
                "criteria": [
                  "I can say why partners leave."
                ],
                "tactics": [
                  "Join partner QBRs"
                ]
              }
            },
            "d90": {
              "example": {
                "objective": "Win support",
                "criteria": [
                  "Top partners have reviewed my plan."
                ],
                "tactics": [
                  "Preview plan"
                ]
              }
            }
          }
        },
        {
          "id": "mechanisms",
          "name": "Mechanisms",
          "cells": {
            "d30": {
              "example": {
                "objective": "Learn the signal",
                "criteria": [
                  "I can name every customer review and owner."
                ],
                "tactics": [
                  "Sit in this week's customer-signal review"
                ]
              }
            },
            "d60": {
              "example": {
                "objective": "See what we miss",
                "criteria": [
                  "I can say which customer pain never reaches the review."
                ],
                "tactics": [
                  "Bring tickets to the weekly signal review"
                ]
              }
            },
            "d90": {
              "example": {
                "objective": "Own the cadence",
                "criteria": [
                  "I have taken ownership of the weekly customer-signal review."
                ],
                "tactics": [
                  "Write the signal-review agenda"
                ]
              }
            }
          }
        }
      ]
    },
